{
  "name": "factorio-blueprints-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin and shared core library for the factorio-blueprints vault",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "test:corpus": "node --test test/corpus/corpus.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  }
}
